<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>Flit.Infrastructure</RootNamespace>
    <PublishAot>false</PublishAot>
    <IsAotCompatible>false</IsAotCompatible>
    <NuGetAuditMode>direct</NuGetAuditMode>
    <NoWarn>$(NoWarn);CA1861</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Migrations\Sql\AddProceduresConfigRulesRgl01_up.sql" />
    <EmbeddedResource Include="Migrations\Sql\AddProceduresConfigRulesRgl01_down.sql" />
    <EmbeddedResource Include="Migrations\Sql\AddIntegrationsEndpointCallLogRgl02_up.sql" />
    <EmbeddedResource Include="Migrations\Sql\AddIntegrationsEndpointCallLogRgl02_down.sql" />
    <EmbeddedResource Include="Migrations\Sql\AddProceduresConfigParametrization50_up.sql" />
    <EmbeddedResource Include="Migrations\Sql\AddProceduresConfigParametrization50_down.sql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Flit.SharedKernel\Flit.SharedKernel.csproj" />
    <ProjectReference Include="..\Flit.Modules.Identity\Flit.Modules.Identity.csproj" />
    <ProjectReference Include="..\Flit.Modules.Users\Flit.Modules.Users.csproj" />
    <ProjectReference Include="..\Flit.Modules.Auth\Flit.Modules.Auth.csproj" />
    <ProjectReference Include="..\Flit.Modules.Rbac\Flit.Modules.Rbac.csproj" />
    <ProjectReference Include="..\Flit.Modules.Notifications\Flit.Modules.Notifications.csproj" />
    <ProjectReference Include="..\Flit.Modules.ProceduresConfig\Flit.Modules.ProceduresConfig.csproj" />
  </ItemGroup>

</Project>
