<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>Flit.Modules.Integrations</RootNamespace>
    <PublishAot>false</PublishAot>
    <IsAotCompatible>false</IsAotCompatible>
    <NuGetAuditMode>direct</NuGetAuditMode>
    <!-- CA1862: StringComparison overload not applicable inside EF Core LINQ-to-SQL expression trees -->
    <!-- CA1848/CA1873: logger performance hints — aceptados para connectors de infraestructura -->
    <NoWarn>$(NoWarn);CA1862;CA1848;CA1873</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Flit.Infrastructure\Flit.Infrastructure.csproj" />
    <ProjectReference Include="..\Flit.SharedKernel\Flit.SharedKernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

</Project>
