# .env de DEVELOP/STAGING (VPS) — copia a `.env` en la carpeta de deploy de develop.
# Mismo VPS y mismo docker-compose.prod.yml que produccion, pero AISLADO:
# distinto proyecto, puertos, dominios, paquete de imagen, tag y base de datos.
# NO commitear el .env real. Este .example solo documenta las variables.
#
# Puertos host develop: frontend 40106, gateway 40206, core-api 40306.

# ── Aislamiento del proyecto (DISTINTO a produccion) ─────────────────────────
COMPOSE_PROJECT_NAME=flit-dev
FRONTEND_PORT=40106
GATEWAY_PORT=40206
CORE_API_PORT=40306

# ── Imagen GHCR: paquete + tag de develop (prod usa jormanc-pdn + latest) ────
IMAGE_NAMESPACE=jormanc-dev
CORE_API_TAG=develop
FRONTEND_TAG=develop

# ── Base de datos (BD separada en el Postgres del HOST) ──────────────────────
CONNECTION_STRING_CORE=Host=host.docker.internal;Port=5432;Database=db_jormanc_dev;Username=user_jormanc_dev;Password=CAMBIA_ESTA_PASSWORD;SSL Mode=Disable

# ── Entorno .NET (prod usa Production por default) ───────────────────────────
ASPNETCORE_ENV=Development

# ── CORS / dominios (dominio de develop) ─────────────────────────────────────
CORS_ORIGIN=https://dev.jormanc.flitsas.online

# ── Verifik (RUNT) ──
VERIFIK_API_TOKEN=CAMBIA_ESTE_TOKEN
VERIFIK_BASE_URL=https://api.verifik.co
VERIFIK_TIMEOUT_SECONDS=30
