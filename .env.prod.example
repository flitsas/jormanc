# .env de PRODUCCION (VPS) — copia a `.env` junto a docker-compose.prod.yml.
# NO commitear el .env real. Este .example solo documenta las variables.
#
# Topologia: frontend + gateway + core-api. Postgres en el HOST.
# Puertos host por defecto: frontend 60106, gateway 60206, core-api 60306.

# ── Aislamiento del proyecto (UNICO por proyecto en el VPS) ──────────────────
# Si tienes varios proyectos similares en el mismo VPS, ESTOS valores DEBEN ser
# distintos en cada uno, o un deploy borrara/chocara con los contenedores del otro.
# Este repo usa flit-prod (no lo cambies aqui para no orfanar los contenedores ya
# desplegados). En OTROS repos, define un nombre y puertos propios.
COMPOSE_PROJECT_NAME=flit-prod
# Rango de puertos host (127.0.0.1). Usa un rango distinto por proyecto (ej: 61106/61206/61306).
FRONTEND_PORT=60106
GATEWAY_PORT=60206
CORE_API_PORT=60306

# ── Base de datos (Postgres del HOST, formato Npgsql .NET — NO la URL postgres://) ──
# Equivale a: postgres://flit:PASSWORD@host.docker.internal:5432/flit_dev?sslmode=disable
CONNECTION_STRING_CORE=Host=host.docker.internal;Port=5432;Database=flit_dev;Username=flit;Password=CAMBIA_ESTA_PASSWORD;SSL Mode=Disable

# ── CORS / dominios ──
CORS_ORIGIN=https://orca.flitsas.com

# ── JWT ──
# Login deshabilitado temporalmente: NO se requieren llaves ni variables JWT.
# Para reactivar login en el futuro, generar llaves RS256 (scripts/gen-secrets.sh),
# montarlas en el compose y definir JWT_ISSUER / JWT_AUDIENCE.

# ── Verifik (RUNT) ──
VERIFIK_API_TOKEN=CAMBIA_ESTE_TOKEN
VERIFIK_BASE_URL=https://api.verifik.co
VERIFIK_TIMEOUT_SECONDS=30

# ── Imagen GHCR: paquete + tag de produccion ────────────────────────────────
# IMAGE_NAMESPACE selecciona el paquete (prod=jormanc-pdn, dev=jormanc-dev).
IMAGE_NAMESPACE=jormanc-pdn
CORE_API_TAG=latest
FRONTEND_TAG=latest
